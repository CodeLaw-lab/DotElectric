<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- Light Theme — палитра: цвета и кисти.      -->
    <!-- Структура стилей — общая, живёт в          -->
    <!-- ThemeStructure.xaml и берёт кисти через    -->
    <!-- DynamicResource.                           -->
    <!-- ========================================== -->

    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="SelectionBlue">#42A5F5</Color>
    <Color x:Key="SelectionGreen">#66BB6A</Color>

    <!-- Background Colors -->
    <Color x:Key="WindowBackgroundColor">#FAFAFA</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CanvasBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ToolBarBackgroundColor">#F5F5F5</Color>
    <Color x:Key="StatusBarBackgroundColor">#F5F5F5</Color>
    <Color x:Key="MenuBackgroundColor">#F5F5F5</Color>
    <Color x:Key="TabControlBackgroundColor">#FAFAFA</Color>
    <Color x:Key="TabItemBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TabItemSelectedBackgroundColor">#E3F2FD</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="TextDisabledColor">#BDBDBD</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="BorderLightColor">#F5F5F5</Color>

    <!-- Hover/Pressed Colors -->
    <Color x:Key="HoverBackgroundColor">#E3F2FD</Color>
    <Color x:Key="PressedBackgroundColor">#BBDEFB</Color>
    <Color x:Key="SelectedBackgroundColor">#0078D4</Color>

    <!-- Специфичные цвета светлой темы -->
    <Color x:Key="TabCloseButtonHoverColor">#FF0000</Color>
    <Color x:Key="WarningOrangeColor">#FF8C00</Color>

    <!-- Solid Brushes: кисти ссылаются на цвета своей палитры -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectionBlueBrush" Color="{StaticResource SelectionBlue}"/>
    <SolidColorBrush x:Key="SelectionGreenBrush" Color="{StaticResource SelectionGreen}"/>
    <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrangeColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}"/>
    <SolidColorBrush x:Key="ToolBarBackgroundBrush" Color="{StaticResource ToolBarBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="TabControlBackgroundBrush" Color="{StaticResource TabControlBackgroundColor}"/>
    <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="{StaticResource TabItemBackgroundColor}"/>
    <SolidColorBrush x:Key="TabItemSelectedBackgroundBrush" Color="{StaticResource TabItemSelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="TabCloseButtonHoverBrush" Color="{StaticResource TabCloseButtonHoverColor}"/>

</ResourceDictionary>
